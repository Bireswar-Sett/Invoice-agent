# Public URL of the A2A base endpoint, INCLUDING the configured base path.
# Example: https://your-service.onrender.com/a2a/
# On Render, leave blank to derive it from RENDER_EXTERNAL_URL + A2A_BASE_PATH.
PUBLIC_BASE_URL=
A2A_BASE_PATH=/a2a

# Use Render Postgres in production. SQLite is only suitable for local development.
DATABASE_URL=sqlite:///.data/invoice-agent.db

# OpenAI-compatible chat-completions endpoint. Works with OpenAI and compatible providers.
AI_BASE_URL=https://aipipe.org/openai/v1
AI_API_KEY=
AI_MODEL=gpt-5-nano
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=38
AI_MAX_OUTPUT_TOKENS=12000

# Optional prompt override. Leave blank to use the built-in invoice policy prompt.
AI_SYSTEM_PROMPT=

# Limits and runtime
MAX_REQUEST_BYTES=2097152
MAX_RESPONSE_BYTES=524288
MAX_PACKAGES_PER_BATCH=60
LOG_LEVEL=INFO
